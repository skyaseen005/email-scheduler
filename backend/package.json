{
  "name": "reachinbox-email-scheduler-backend",
  "version": "1.0.0",
  "description": "Production-grade email scheduler service with BullMQ and Redis",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "ts-node src/workers/emailWorker.ts",
    "db:migrate": "ts-node src/database/migrations/run-migrations.ts"
  },
  "keywords": ["email", "scheduler", "bullmq", "redis"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bullmq": "^5.1.0",
    "ioredis": "^5.3.2",
    "nodemailer": "^6.9.7",
    "mysql2": "^3.6.5",
    "csv-parser": "^3.0.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "express-session": "^1.17.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/cors": "^2.8.17",
    "@types/nodemailer": "^6.4.14",
    "@types/multer": "^1.4.11",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/express-session": "^1.17.10",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2"
  }
